# Port for backend service
PORT=8000

# Optional API Key (leave empty to disable API key requirement)
API_KEY=

# Per-minute rate limit per IP
RATE_LIMIT_PER_MINUTE=30

# Allowed CORS origins (comma-separated, e.g. chrome-extension://<your-extension-id>)
CORS_ALLOWED_ORIGINS=*

# Paths inside container / host
MODEL_DIR=/app/backend/model
BANDS_FILE=/app/backend/app/bands.json

# Domain name for Caddy automatic HTTPS (production)
DOMAIN=example.com
