{
  "manifest_version": 3,
  "name": "Bangla Fake News Detector",
  "version": "1.0.0",
  "description": "Estimates resemblance to fake or misleading Bangla news using a fine-tuned BanglaBERT model.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Bangla Fake News Detector"
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": false
  },
  "background": {
    "service_worker": "src/background.js"
  }
}

